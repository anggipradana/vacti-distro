#!/usr/bin/env bash
# /usr/local/sbin/vacti-firstboot - the ONE first-boot enroll code path behind
# every channel (NoCloud user-data / cloud provider metadata / VMware guestinfo
# / a console-dropped file / a GUI first-run dialog). Baked into the image; the
# SECRET it consumes is never baked - it arrives per-instance.
#
# What it does (mirrors the engine's bootstrap-apt.sh --enroll flow):
#   1. locate a per-boot enroll token + the control-plane URL (no baked secret);
#   2. POST it to <url>/api/pentest/enroll to exchange for the scoped tokens;
#   3. write /etc/vacti-engine/engine.env (0600) and start vacti-engine;
#   4. disable this unit. Fail LOUDLY if no live token is present.
set -euo pipefail

CFG_DIR="/etc/vacti-engine"
CFG_ENV="${CFG_DIR}/engine.env"
SELF_UNIT="${VACTI_FIRSTBOOT_UNIT:-vacti-firstboot.service}"

log()  { echo "[vacti-firstboot] $*"; }
die()  { echo "[vacti-firstboot][FATAL] $*" >&2; exit 1; }

# Shared, operator-visible progress log. The pre-login kiosk tails this file so an
# operator can SEE which enrollment phase is running (or stuck) WITHOUT SSH - on the
# appliance no tailscale key is typed in, so the journal is otherwise unreachable.
# vacti-engine-install writes to the SAME file, so the tail shows the whole chain
# (engine bake/pull -> enroll POST). Best-effort + world-readable; never fatal.
PROGRESS_LOG="${VACTI_PROGRESS_LOG:-/var/log/vacti-firstboot-progress.log}"
progress() { # PHASE message...
  local phase="${1:-STEP}"; shift || true
  log "${phase} $*"
  { printf '%s [vacti-firstboot] %s %s\n' \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true)" "$phase" "$*" \
      >> "$PROGRESS_LOG"; } 2>/dev/null || true
  chmod 0644 "$PROGRESS_LOG" 2>/dev/null || true
}

# Ensure sshd is up for operator access (tailscale SSH) BEFORE any early-exit or
# die below, so the box stays reachable even when enrollment is skipped (engine.env
# already present) or fails (no live token). openssh-server is baked and the golden
# image enables it; '--now' also starts it on this first boot without a reboot.
# Non-fatal (|| true) so it can never block enrollment under 'set -e'.
systemctl enable --now ssh 2>/dev/null || systemctl enable --now sshd 2>/dev/null || true

[[ -f "$CFG_ENV" ]] && { log "engine.env already present - nothing to do"; exit 0; }

# --- 1. locate the per-boot token + CP url (first channel that yields a token) ---
# cloud-init writes NoCloud/provider user-data to /run or /var/lib/cloud; we also
# accept a plain file-drop and the kernel cmdline. NONE of these ship in the image.
ENROLL_TOKEN=""
VACTI_URL=""
ENGINE_ID="$(hostname -s 2>/dev/null || echo engine)"

# (a) a well-known file drop (console / preseed late_command / GUI dialog write)
TOKEN_FILE="${VACTI_ENROLL_FILE:-/etc/vacti-engine/enroll.token}"
if [[ -s "$TOKEN_FILE" ]]; then
  # format: first line = token, optional second line = url
  ENROLL_TOKEN="$(sed -n '1p' "$TOKEN_FILE")"
  VACTI_URL="$(sed -n '2p' "$TOKEN_FILE")"
fi

# (b) cloud-init user-data (NoCloud CIDATA / provider metadata / guestinfo) - a
#     tiny YAML/JSON carrying vacti_enroll_token + vacti_url written by cloud-init
#     to a known path. We read it without a full cloud-init module dependency.
for ud in /run/vacti/enroll.env /var/lib/cloud/instance/vacti-enroll.env; do
  if [[ -z "$ENROLL_TOKEN" && -s "$ud" ]]; then
    # shellcheck disable=SC1090
    source "$ud" || true
    ENROLL_TOKEN="${vacti_enroll_token:-${VACTI_ENROLL_TOKEN:-}}"
    VACTI_URL="${vacti_url:-${VACTI_URL:-}}"
  fi
done

# (c) kernel cmdline fallback: vacti.enroll_token=... vacti.url=...
if [[ -z "$ENROLL_TOKEN" ]] && grep -q 'vacti.enroll_token=' /proc/cmdline 2>/dev/null; then
  ENROLL_TOKEN="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^vacti.enroll_token=//p')"
  VACTI_URL="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^vacti.url=//p')"
fi

[[ -n "$ENROLL_TOKEN" ]] || die "no per-boot enroll token found (file/NoCloud/guestinfo/cmdline all empty). \
Mint a FRESH single-use token in the dashboard and supply it via a cidata.iso seed (see distro/enroll/). \
NO long-lived fallback is baked - this image is inert without a live enrollment."
[[ -n "$VACTI_URL" ]] || die "enroll token present but no control-plane URL (set vacti_url in the seed)"

# --- 2. exchange the token for the scoped engine tokens -----------------------
BASE="${VACTI_URL%/}"
progress TOKEN_OK "enroll token located; control-plane=${BASE}"

# BOUNDED RETRY + BACKOFF. A single-shot POST made the appliance fragile to a cold
# TLS/DNS warm-up, a transient 5xx, or a per-IP 429 window right after the exchange.
# Retry only the TRANSIENT codes (000 no-connection / 5xx / 429); a hard client error
# (dead/used/invalid token) will never recover, so fail fast + loud on those. Every
# attempt and its HTTP code is written to the progress log the kiosk tails.
ENROLL_MAX_ATTEMPTS="${VACTI_ENROLL_ATTEMPTS:-6}"
http_code="000"
attempt=1
backoff=2
while (( attempt <= ENROLL_MAX_ATTEMPTS )); do
  progress ENROLL_POST "attempt ${attempt}/${ENROLL_MAX_ATTEMPTS} -> POST ${BASE}/api/pentest/enroll (engine_id=${ENGINE_ID}, token not logged)"
  http_code="$(curl -sS -o /run/vacti-enroll.out -w '%{http_code}' \
    --connect-timeout 10 --max-time 60 \
    -H "Authorization: Bearer ${ENROLL_TOKEN}" \
    -H 'Content-Type: application/json' \
    -X POST "${BASE}/api/pentest/enroll" \
    -d "{\"engine_id\":\"${ENGINE_ID}\"}" || echo "000")"
  progress ENROLL_HTTP "attempt ${attempt}/${ENROLL_MAX_ATTEMPTS} http=${http_code}"
  case "$http_code" in
    200) break ;;
    400|401|403|404|409|410)
      body="$(cat /run/vacti-enroll.out 2>/dev/null || true)"; rm -f /run/vacti-enroll.out
      progress ENROLL_FATAL "HTTP ${http_code} - token rejected (expired/used/invalid); re-mint in the dashboard"
      die "enroll rejected (HTTP ${http_code}). Token likely expired/used (single-use, 3h TTL). Re-mint and retry. Response: ${body:-none}"
      ;;
    *)
      # 000 (no connection) / 5xx / 429 / any transient: back off and retry.
      if (( attempt < ENROLL_MAX_ATTEMPTS )); then
        progress ENROLL_RETRY "HTTP ${http_code} - retrying in ${backoff}s"
        sleep "$backoff"
        backoff=$(( backoff * 2 )); (( backoff > 30 )) && backoff=30
      fi
      ;;
  esac
  attempt=$(( attempt + 1 ))
done

if [[ "$http_code" != "200" ]]; then
  body="$(cat /run/vacti-enroll.out 2>/dev/null || true)"; rm -f /run/vacti-enroll.out
  progress ENROLL_FATAL "all ${ENROLL_MAX_ATTEMPTS} attempts failed (last HTTP ${http_code})"
  die "enroll failed after ${ENROLL_MAX_ATTEMPTS} attempts (last HTTP ${http_code}). Check CP reachability / token. Response: ${body:-none}"
fi
progress ENROLL_OK "HTTP 200 - scoped tokens received; writing engine.env"

# --- 3. write engine.env (0600). The actual field parsing is the engine's job;
#     we hand the response to the engine's own enroll writer if present, else
#     write the scoped tokens the API returned. Token VALUES are never logged. ---
install -d -m0755 "$CFG_DIR"
umask 077
if command -v vacti-engine-write-env >/dev/null 2>&1; then
  vacti-engine-write-env --url "$BASE" --from /run/vacti-enroll.out
else
  # Minimal inline writer: the enroll response is JSON with the three scoped
  # tokens plus the OPTIONAL edge shared secret. Use jq if present, else node
  # (both ship in the arsenal/.deb).
  #
  # VACTI_ENGINE_SHARED_SECRET: Caddy at the public edge Basic-traps (401 realm
  # "restricted") every engine writeback - heartbeat (/api/pentest/runners/heartbeat),
  # jobs/next, knowledge/catalog, engine-config - unless the request carries
  # X-Engine-Auth == this secret. Only the Bearer-exempt /enroll* subtree is reachable
  # without it, so WITHOUT this line a container ENROLLS fine but its first heartbeat is
  # 401'd when it reaches the control plane over the public edge (on-tailnet engines hit
  # the runner API internally and never cross the edge Basic gate, which is why the live
  # fleet was unaffected). The terminal installer (engine bootstrap-apt.sh) already
  # provisions this from the SAME enroll field; this brings the appliance / Docker
  # first-boot path to parity. Emit ONLY when the CP returned a non-empty value, so an
  # unset CP env var yields a byte-identical engine.env to the pre-feature behaviour.
  {
    echo "VACTI_URL=${BASE}"
    if command -v jq >/dev/null 2>&1; then
      jq -r '
        "VACTI_PRODUCER_TOKEN=\(.producer_token // .producer // "")",
        "VACTI_VERIFIER_TOKEN=\(.verifier_token // .verifier // "")",
        "VACTI_GATEKEEPER_TOKEN=\(.gatekeeper_token // .gatekeeper // "")"
      ' /run/vacti-enroll.out
      secret="$(jq -r '.engineSharedSecret // .engine_shared_secret // empty' /run/vacti-enroll.out 2>/dev/null || true)"
      [[ -n "$secret" ]] && printf 'VACTI_ENGINE_SHARED_SECRET=%s\n' "$secret"
      unset secret
    else
      # Robust node fallback (the previous one-liner required an unresolvable path and
      # wrote nothing). Read + parse the response and emit only non-empty values.
      node -e '
        const fs = require("fs");
        const j = JSON.parse(fs.readFileSync("/run/vacti-enroll.out", "utf8"));
        const w = (k, v) => { if (v) process.stdout.write(k + "=" + v + "\n"); };
        w("VACTI_PRODUCER_TOKEN", j.producer_token || j.producer);
        w("VACTI_VERIFIER_TOKEN", j.verifier_token || j.verifier);
        w("VACTI_GATEKEEPER_TOKEN", j.gatekeeper_token || j.gatekeeper);
        w("VACTI_ENGINE_SHARED_SECRET", j.engineSharedSecret || j.engine_shared_secret);
      ' 2>/dev/null || true
    fi
  } > "$CFG_ENV"
fi
chmod 0600 "$CFG_ENV"
umask 022
rm -f /run/vacti-enroll.out

# Wipe the consumed one-time token from disk if it was file-dropped.
[[ -f "$TOKEN_FILE" ]] && shred -u "$TOKEN_FILE" 2>/dev/null || rm -f "$TOKEN_FILE" 2>/dev/null || true

# --- 4. start the engine + disable this unit ---
progress ENV_WRITTEN "engine.env written; starting vacti-engine and disabling ${SELF_UNIT}"
systemctl start vacti-engine.service 2>/dev/null || log "vacti-engine start deferred to its own unit"
# FAT-OVA ONLY: a baked engine may be older than the current release; converge now
# instead of waiting for the update timer's OnBootSec. Gated STRICTLY on the fat-OVA
# build marker (written only when the engine was baked at build time), so a THIN image's
# first boot is byte-for-byte unchanged - the timer handles its first pull either way.
# Idle-gated + fail-open inside the unit; --no-block so it never delays enrollment.
if [[ -f "${CFG_DIR}/fat-ova" ]]; then
  log "FAT-OVA: kicking an immediate engine update to converge the baked engine"
  systemctl start --no-block vacti-engine-update.service 2>/dev/null || true
fi
systemctl disable "${SELF_UNIT}" 2>/dev/null || true
progress DONE "first-boot enrollment complete"

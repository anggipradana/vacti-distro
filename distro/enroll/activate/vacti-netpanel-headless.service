# vacti-netpanel-headless.service - POST-ENROLL console network panel (headless SKU).
#
# The headless twin of vacti-netpanel.service: graceful degradation to nmtui on the
# console instead of a GUI panel. Only relevant on a headless image that ships
# NetworkManager (VACTI_HEADLESS_NM=1); the build enables it ONLY there, so the
# default zero-touch cloud-init/systemd-networkd headless image is UNCHANGED (it
# never had a desktop login to replace, and auto-seizing tty1 would regress the
# zero-touch seed path). Staged unconditionally; inert unless its conditions hold.
#
# FAIL-OPEN: Restart=no + OnFailure=getty@tty1.service. An nmtui failure lands the
# operator on exactly the getty login they would otherwise have gotten.
[Unit]
Description=vacti post-enroll console network panel (nmtui, headless SKU)
After=systemd-user-sessions.service NetworkManager.service
Wants=NetworkManager.service
Conflicts=getty@tty1.service
Before=getty@tty1.service
OnFailure=getty@tty1.service
# Only AFTER enrollment, only on the headless SKU (no LightDM).
ConditionPathExists=/etc/vacti-engine/engine.env
ConditionPathExists=!/etc/lightdm
ConditionPathExists=!/var/lib/vacti/netpanel-optout

[Service]
Type=idle
ExecStart=/usr/local/sbin/vacti-netpanel --headless
Restart=no
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=journal+console

[Install]
WantedBy=multi-user.target

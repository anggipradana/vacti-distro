        # operator can SEE where a long/stuck enroll is (e.g. "ENROLL_HTTP http=000")
        # without SSH. Dim + monospace; empty until the enroll chain writes a line.
        self.busy_detail = Gtk.Label(label="")
        self.busy_detail.add_css_class("dim-label")
        self.busy_detail.add_css_class("caption")
        self.busy_detail.set_wrap(True)
        self.busy_detail.set_justify(Gtk.Justification.CENTER)
        self.busy_detail.set_selectable(True)
        box.append(self.busy_detail)
        page.set_child(box)
        return page

    # ---- helpers -----------------------------------------------------------
    def _refresh_status(self):
        def work():
            _, line = _run(["__net-status"], capture=True, timeout=10)
            GLib.idle_add(self._apply_status, line)
        threading.Thread(target=work, daemon=True).start()
        return True  # keep the GLib timer alive

    def _apply_status(self, line):
        self._last_status_line = line
        # Connectivity is detected by the presence of an IPv4 (language-neutral),
        # not by any localized word in the status line.
        connected = bool(line) and bool(IPV4_RE.search(line))
        dot = "●"  # ●
        text = line or t("status_not_connected")
        markup_cls = "vacti-ok" if connected else "vacti-warn"
        if hasattr(self, "net_row"):
            self.net_row.set_subtitle(text)
        self.status_lbl.set_text(f"{dot} {text}")
        self.status_lbl.remove_css_class("vacti-ok")
        self.status_lbl.remove_css_class("vacti-warn")
        self.status_lbl.add_css_class(markup_cls)
        return False

    def on_code_changed(self, _row):
        raw = self.code_row.get_text()
        if not raw:
            self.code_hint.set_text("")
            return
        if is_short_code(raw):
            self.code_hint.set_text(t("hint_short"))
            self.code_hint.remove_css_class("vacti-warn")
            self.code_hint.add_css_class("vacti-ok")
        else:
            self.code_hint.set_text(t("hint_token"))
            self.code_hint.remove_css_class("vacti-ok")
            self.code_hint.add_css_class("vacti-warn")

    def _banner(self, text):
        self.banner.set_title(text)
        self.banner.set_revealed(True)

    def _toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    def _busy(self, text):
        self.busy_lbl.set_text(text)
        self.root.set_visible_child_name("busy")
        # Start tailing the shared progress log so the operator sees the live phase.
        self._start_progress_tail()

    def _start_progress_tail(self):
        if getattr(self, "_progress_timer", None):
            return
        self._tail_progress()  # paint immediately
        self._progress_timer = GLib.timeout_add_seconds(2, self._tail_progress)

    def _stop_progress_tail(self):
        tid = getattr(self, "_progress_timer", None)
        if tid:
            GLib.source_remove(tid)
            self._progress_timer = None

    def _tail_progress(self):
        line = _last_progress_line()
        if line:
            self.busy_detail.set_text(line)
        return True  # keep the timer alive while busy

    def _back_to_main(self, toast=None):
        self._stop_progress_tail()
        self.root.set_visible_child_name("main")
        self.activate_btn.set_sensitive(True)
        if toast:
            self._toast(toast)
        return False

    def _enroll_failed(self, base_msg):
        # Persistent (not a transient toast) so the operator can read the diagnostic.
        # Append the last progress line - it names the exact stuck/failed phase.
        self._stop_progress_tail()
        last = _last_progress_line()
        msg = base_msg
        if last:
            msg = "{}  [{}]".format(base_msg, last)
        self.root.set_visible_child_name("main")
        self.activate_btn.set_sensitive(True)
        self._banner(msg)
        return False

    # ---- network actions ---------------------------------------------------
    def on_net_connect(self, _btn):
        self.net_spinner.start()

        def work():
            _, line = _run(["__net-connect-quiet"], capture=True, timeout=40)
            GLib.idle_add(self._net_connected, line)
        threading.Thread(target=work, daemon=True).start()

    def _net_connected(self, line):
        self.net_spinner.stop()
        self._apply_status(line)
        return False

    def on_net_editor(self, _btn):
        try:
            subprocess.Popen(
                ["nm-connection-editor"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception:
            self._toast(t("net_editor_unavailable"))

    # ---- activation pipeline ----------------------------------------------
    def on_activate(self, _btn):
        self.banner.set_revealed(False)
        url = self.url_row.get_text().strip()
        code = self.code_row.get_text().strip()
        proxy = self.proxy_row.get_text().strip()
        tskey = self.tskey_row.get_text().strip()

        if not url or not code:
            self._banner(t("err_required"))
            self.stack.set_visible_child_name("enroll")
            return

        self.activate_btn.set_sensitive(False)
        self._busy(t("busy_net"))
        threading.Thread(
            target=self._pipeline, args=(url, code, proxy, tskey), daemon=True
        ).start()

    def _pipeline(self, url, code, proxy, tskey):
        # 1. optional proxy / tailscale (secrets via env, not argv).
        _run(
            ["__apply-optional", url],
            extra_env={"VACTI_PROXY": proxy, "VACTI_TSKEY": tskey},
            timeout=60,
        )
        # 2. reachability.
        rc, _ = _run(["__reachable", url], timeout=30)
        if rc != 0:
            GLib.idle_add(
                self._back_to_main,
                t("err_unreachable", url=url),
            )
            return
        # 3. resolve the short code -> full token (or pass the token through).
        token = code
        if is_short_code(code):
            GLib.idle_add(self._busy, t("busy_exchange"))
            rc, out = _run(
                ["__exchange", url],
                extra_env={"VACTI_CODE": normalize_code(code)},
                capture=True,
                timeout=40,
            )
            msg = {
                44: t("err_notfound"),
                41: t("err_gone"),
                42: t("err_rate"),
            }
            if rc != 0:
                GLib.idle_add(
                    self._back_to_main,
                    msg.get(rc, t("err_exchange_net")),
                )
                return
            token = out
            if not token:
                GLib.idle_add(
                    self._back_to_main, t("err_token_empty")
                )
                return
        # 4. stage enroll.token + run the existing firstboot enroll chain.
        GLib.idle_add(
            self._busy,
            t("busy_enroll"),
        )
        rc, _ = _run(
            ["__enroll", url], extra_env={"VACTI_TOKEN": token}, timeout=360
        )
        if rc == 0:
            GLib.idle_add(self._show_success)
        else:
            # Persist the failure + the exact stuck/failed phase from the progress log.
            GLib.idle_add(self._enroll_failed, t("err_enroll"))

    def _show_success(self):
        self._stop_progress_tail()
        self.success_page.set_icon_name("emblem-ok-symbolic")
        self.success_page.set_title(t("success_title"))
        self._reboot_left = 10
        self.success_page.set_description(
            t("success_desc", n=self._reboot_left)
        )
        self.root.set_visible_child_name("success")
        GLib.timeout_add_seconds(1, self._tick_reboot)
        return False

    def _tick_reboot(self):
        self._reboot_left -= 1
        if self._reboot_left <= 0:
            _run(["__finish"], timeout=20)
            return False
        self.success_page.set_description(
            t("success_desc", n=self._reboot_left)
        )
        return True

    def on_cancel(self, _btn):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading=t("cancel_heading"),
            body=t("cancel_body"),
        )
        dialog.add_response("back", t("cancel_back"))
        dialog.add_response("exit", t("cancel_exit"))
        dialog.set_response_appearance(
            "exit", Adw.ResponseAppearance.DESTRUCTIVE
        )
        dialog.set_default_response("back")
        dialog.connect("response", self._on_cancel_response)
        dialog.present()

    def _on_cancel_response(self, _dialog, response):
        if response == "exit":
            global EXIT_CODE
            EXIT_CODE = 10
            self.get_application().quit()


class KioskApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="id.vacti.Kiosk",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(
            Adw.ColorScheme.FORCE_DARK
        )
        if os.path.isfile(CSS_PATH):
            try:
                provider = Gtk.CssProvider()
                provider.load_from_path(CSS_PATH)
                display = Gdk.Display.get_default()
                if display is not None:
                    Gtk.StyleContext.add_provider_for_display(
                        display,
                        provider,
                        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
                    )
            except Exception:
                pass

    def do_activate(self):
        win = KioskWindow(self)
        win.present()


def main():
    app = KioskApp()
    app.run(None)
    return EXIT_CODE


if __name__ == "__main__":
    sys.exit(main())

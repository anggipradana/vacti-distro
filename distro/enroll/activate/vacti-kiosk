# A short code is 8 chars from a Crockford-ish alphabet (no I/O/0/1), optionally
# hyphenated XXXX-XXXX. Everything else is treated as a full token.
SHORT_CODE_RE = re.compile(r"^[A-HJ-NP-Z2-9]{4}-?[A-HJ-NP-Z2-9]{4}$")
# Language-independent "are we online?" probe for the status line (the text comes
# back localized from the bash helper, so we detect connectivity by the IP, not a
# word in any one language).
IPV4_RE = re.compile(r"\b\d{1,3}(?:\.\d{1,3}){3}\b")

# Shared progress log written by vacti-firstboot + vacti-engine-install. We tail its
# last line into the busy pane so the operator SEES which enrollment phase is running
# (or stuck) without SSH - the appliance has no tailscale key typed in. Read-only,
# fail-soft (the file may not exist until the enroll chain starts).
PROGRESS_LOG = os.environ.get(
    "VACTI_PROGRESS_LOG", "/var/log/vacti-firstboot-progress.log"
)


def _last_progress_line():
    """Return the last non-empty line of the shared progress log, or '' (fail-soft)."""
    try:
        with open(PROGRESS_LOG, "r", errors="replace") as fh:
            lines = [ln.strip() for ln in fh.readlines() if ln.strip()]
        return lines[-1] if lines else ""
    except Exception:
        return ""


def _flag_lang(argv):
    for i, a in enumerate(argv):
        if a == "--lang" and i + 1 < len(argv):
            return argv[i + 1].strip().lower()
        if a.startswith("--lang="):
            return a.split("=", 1)[1].strip().lower()
    return None


def _positional_args(argv):
    """argv minus the --lang flag (so argv[1] can still override ACTIVATE)."""
    out, skip = [], False
    for a in argv[1:]:
        if skip:
            skip = False
            continue
        if a == "--lang":
            skip = True
            continue
        if a.startswith("--lang="):
            continue
        out.append(a)
    return out


def _saved_lang():
    try:
        with open(LANG_FILE) as fh:
            v = fh.read().strip().lower()
            return v if v in SUPPORTED_LANGS else None
    except Exception:
        return None


def resolve_lang():
    # Precedence: --lang > VACTI_LANG > persisted file > $LANG autodetect > default.
    flag = _flag_lang(sys.argv)
    if flag in SUPPORTED_LANGS:
        return flag
    env = (os.environ.get("VACTI_LANG") or "").strip().lower()
    if env in SUPPORTED_LANGS:
        return env
    saved = _saved_lang()
    if saved:
        return saved
    loc = (
        os.environ.get("LANG")
        or os.environ.get("LC_ALL")
        or os.environ.get("LC_MESSAGES")
        or ""
    ).lower()
    if loc.startswith("id"):
        return "id"
    if loc:
        return "en"
    return DEFAULT_LANG


CURRENT_LANG = resolve_lang()


def save_lang(lang):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(LANG_FILE, "w") as fh:
            fh.write(lang + "\n")
    except Exception:
        pass  # a read-only HOME must never break the kiosk (fail-soft).


def t(key, **fmt):
    """Translate KEY in the current language; fall back to EN, then the key."""
    s = STRINGS.get(CURRENT_LANG, {}).get(key)
    if s is None:
        s = STRINGS["en"].get(key)
        if s is None:
            sys.stderr.write(f"[vacti-kiosk] missing i18n key: {key}\n")
            return key
        if CURRENT_LANG != "en":
            sys.stderr.write(
                f"[vacti-kiosk] i18n key '{key}' missing for "
                f"'{CURRENT_LANG}'; using en\n"
            )
    if fmt:
        try:
            return s.format(**fmt)
        except Exception:
            return s
    return s


# The bash driver we delegate privileged work to (first non-flag argv overrides).
_POS = _positional_args(sys.argv)
ACTIVATE = _POS[0] if _POS else "/usr/local/sbin/vacti-activate"


def normalize_code(raw):
    return re.sub(r"\s+", "", (raw or "")).upper()


def is_short_code(raw):
    return bool(SHORT_CODE_RE.match(normalize_code(raw)))


def _run(subcmd_args, extra_env=None, capture=False, timeout=360):
    """Run `vacti-activate <subcmd...>`; return (returncode, stdout_text)."""
    env = dict(os.environ)
    env["VACTI_LANG"] = CURRENT_LANG  # keep the whole surface in one language
    if extra_env:
        env.update(extra_env)
    try:
        cp = subprocess.run(
            [ACTIVATE, *subcmd_args],
            env=env,
            capture_output=capture,
            text=True,
            timeout=timeout,
        )
        out = (cp.stdout or "") if capture else ""
        return cp.returncode, out.strip()
    except Exception:
        return 1, ""


class KioskWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        # Registry of zero-arg callables that re-apply a widget's text in the
        # current language, so the ID/EN toggle re-renders in place (no restart).
        self._i18n = []
        self._lang_syncing = False
        self._last_status_line = ""
        self._reg(self.set_title, "win_title")
        self.set_default_size(960, 640)
        self.fullscreen()

        self.toasts = Adw.ToastOverlay()
        self.set_content(self.toasts)

        # An overlay lets the ID/EN language pill float in the top-right corner
        # WITHOUT disturbing the (already-good) centered wizard layout.
        self.overlay = Gtk.Overlay()
        self.toasts.set_child(self.overlay)

        # Top-level view switch: wizard | busy | success.
        self.root = Gtk.Stack()
        self.root.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.overlay.set_child(self.root)
        self.overlay.add_overlay(self._build_lang_switch())

        self.root.add_named(self._build_wizard(), "main")
        self.root.add_named(self._build_busy(), "busy")
        self.success_page = Adw.StatusPage()
        self.root.add_named(self.success_page, "success")
        self.root.set_visible_child_name("main")

        # Live network status refresh.
        self._refresh_status()
        GLib.timeout_add_seconds(3, self._refresh_status)

    # ---- i18n plumbing -----------------------------------------------------
    def _reg(self, apply_fn, key, **fmt):
        """Apply a translated string now AND register it for re-translation."""
        apply_fn(t(key, **fmt))
        self._i18n.append(lambda: apply_fn(t(key, **fmt)))

    def _build_lang_switch(self):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        box.add_css_class("linked")
        box.add_css_class("vacti-lang-switch")
        box.set_halign(Gtk.Align.END)
        box.set_valign(Gtk.Align.START)
        box.set_margin_top(16)
        box.set_margin_end(16)
        self.btn_id = Gtk.ToggleButton(label="ID")
        self.btn_en = Gtk.ToggleButton(label="EN")
        for b in (self.btn_id, self.btn_en):
            b.add_css_class("pill")
        self.btn_id.connect("clicked", lambda *_: self._set_lang("id"))
        self.btn_en.connect("clicked", lambda *_: self._set_lang("en"))
        box.append(self.btn_id)
        box.append(self.btn_en)
        self._sync_lang_switch()
        return box

    def _sync_lang_switch(self):
        self._lang_syncing = True
        self.btn_id.set_active(CURRENT_LANG == "id")
        self.btn_en.set_active(CURRENT_LANG == "en")
        self._lang_syncing = False

    def _set_lang(self, lang):
        if self._lang_syncing or lang not in SUPPORTED_LANGS:
            return
        global CURRENT_LANG
        if lang == CURRENT_LANG:
            self._sync_lang_switch()
            return
        CURRENT_LANG = lang
        save_lang(lang)
        for fn in self._i18n:
            try:
                fn()
            except Exception:
                pass
        self._sync_lang_switch()
        # Re-apply the dynamic (runtime-set) bits too.
        if hasattr(self, "code_row"):
            self.on_code_changed(self.code_row)
        self._apply_status(self._last_status_line)


_lookup() { # key
  local key="$1" val=""
  if [[ "$VACTI_UILANG" == "en" ]]; then
    val="${VT_EN[$key]-}"
  else
    val="${VT_ID[$key]-}"
    if [[ -z "$val" && -n "${VT_EN[$key]-}" ]]; then
      echo "[vacti-activate] i18n key '$key' missing for id; using en" >&2
      val="${VT_EN[$key]}"
    fi
  fi
  if [[ -z "$val" ]]; then
    [[ -z "${VT_EN[$key]-}" ]] && echo "[vacti-activate] missing i18n key: $key" >&2
    val="${VT_EN[$key]-$key}"
  fi
  printf '%s' "$val"
}

# _t KEY [ARG...] -> the translated string with each "{}" replaced by an ARG.
_t() {
  local key="$1"; shift || true
  local val; val="$(_lookup "$key")"
  local a
  for a in "$@"; do val="${val/"{}"/$a}"; done
  printf '%s' "$val"
}

CFG_DIR="/etc/vacti-engine"
CFG_ENV="${CFG_DIR}/engine.env"
TOKEN_FILE="${CFG_DIR}/enroll.token"
PROXY_ENV="${CFG_DIR}/proxy.env"
XLOG="/var/log/vacti-activate.xorg.log"
SELF="$0"

# Branding logo for the kiosk header. Copied into the rootfs by build-golden
# (branding logo/ dir) long before this runs; referenced only if present so a
# stripped image still renders the dialog (fail-soft, works-everywhere).
LOGO=""
for _l in /usr/share/vacti/branding/logo/png/vacti-logomark-128.png \
          /usr/share/vacti/branding/logo/png/vacti-logomark-256.png \
          /usr/share/pixmaps/vacti.svg; do
  [[ -f "$_l" ]] && { LOGO="$_l"; break; }
done

# Premium GTK4 + libadwaita kiosk (preferred GUI). Falls back to the yad notebook
# then zenity if GTK4/Adw are not importable - see run_wizard.
KIOSK_APP="/usr/local/share/vacti-kiosk/vacti-kiosk"
PYTHON_BIN="$(command -v python3 || true)"

log() { echo "[vacti-activate] $*"; }

# The existing first-boot enroll unit is named vacti-firstrun.service on the
# installed/live ISO and vacti-firstboot.service on the cloud/VM golden. Drive
# whichever this image ships - do NOT reimplement the enroll POST.
pick_firstboot_unit() {
  local u
  for u in vacti-firstrun.service vacti-firstboot.service; do
    if systemctl cat "$u" >/dev/null 2>&1; then
      echo "$u"
      return 0
    fi
  done
  echo "vacti-firstboot.service"
}

# ---------------------------------------------------------------------------
# Network helpers (shared by the kiosk tab button + the status label).
# ---------------------------------------------------------------------------
net_status_line() {
  local ip
  ip="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)"
  if [[ -n "$ip" ]]; then
    _t net_connected "$ip"; echo
  else
    _t net_not_connected; echo
  fi
}

# Bring up the first wired/ethernet connection (the NAT-via-DHCP common case).
# No hardcoded connection name: pick the first 802-3-ethernet profile, else
# connect the first ethernet device. Runs as root; also covered by the polkit
# rule when run as the vacti-activate user. UI-free core so both the GTK kiosk
# (quiet, reads the returned status line) and the yad fallback (popup) share it.
_net_connect_core() {
  local con dev
  con="$(nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: '$2=="802-3-ethernet"{print $1; exit}')"
  if [[ -n "$con" ]]; then
    nmcli con up "$con" >/dev/null 2>&1 || true
  else
    dev="$(nmcli -t -f DEVICE,TYPE dev status 2>/dev/null | awk -F: '$2=="ethernet"{print $1; exit}')"
    [[ -n "$dev" ]] && nmcli device connect "$dev" >/dev/null 2>&1 || true
  fi
  sleep 2
}

# yad fallback: connect, then confirm with a branded popup.
do_net_connect() {
  _net_connect_core
  local line; line="$(net_status_line)"
  local args=(--title="$(_t title_network)" --text="${line}" --button="OK:0" --width=380 --center)
  [[ -n "$LOGO" ]] && args+=(--image="$LOGO")
  yad "${args[@]}" 2>/dev/null || true
}

# GTK kiosk: connect silently and print the new status line (no popup; the GTK
# app owns the UI).
do_net_connect_quiet() {
  _net_connect_core
  net_status_line
}

# A short code is 8 chars from a Crockford-ish alphabet (no I/O/0/1), optionally
# hyphenated XXXX-XXXX. Everything else is a full token. Matches the GTK kiosk's
# SHORT_CODE_RE and the CP exchange contract.
is_short_code() { # raw
  local s="${1//[[:space:]]/}"; s="${s^^}"
  [[ "$s" =~ ^[A-HJ-NP-Z2-9]{4}-?[A-HJ-NP-Z2-9]{4}$ ]]
}

# Exchange a short code for the full enrollment token via the CP exchange
# endpoint. Prints the token on stdout on success. Returns: 0 ok, 44=404 not
# found, 41=410 gone/consumed, 42=429 rate-limited, 1=network/other. The code is
# normalised (uppercased, hyphen-stripped) before sending; no value is logged.
resolve_exchange() { # url code
  local base="${1%/}" code="${2//[[:space:]]/}"
  code="${code^^}"; code="${code//-/}"
  local out http tok rc=1
  out="$(mktemp)"
  http="$(curl -sS -o "$out" -w '%{http_code}' --connect-timeout 10 --max-time 20 \
      -H 'Content-Type: application/json' \
      -X POST "${base}/api/pentest/enroll/exchange" \
      --data "$(printf '{"code":"%s"}' "$code")" 2>/dev/null || true)"
  case "$http" in
    200)
      tok="$(jq -r '.token // empty' "$out" 2>/dev/null)"
      [[ -z "$tok" ]] && tok="$(sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$out" | head -n1)"
      if [[ -n "$tok" ]]; then printf '%s' "$tok"; rc=0; else rc=1; fi
      ;;
    404) rc=44 ;;
    410) rc=41 ;;
    429) rc=42 ;;
    *)   rc=1 ;;
  esac
  rm -f "$out"
  return $rc
}

# Returns 0 if the control-plane URL answers within ~15s (HEAD), else non-zero.
reachable() { # url
  local base="${1%/}"
  curl -sS -o /dev/null --connect-timeout 10 --max-time 15 -I "${base}/" >/dev/null 2>&1
}

# Persist optional proxy (for the enroll curl AND the engine) and best-effort
# bring up Tailscale if an auth key was supplied. Neither value is logged.
apply_optional() { # proxy tskey
  local px="${1:-}" ts="${2:-}"
  if [[ -n "$px" ]]; then
    install -d -m0755 "$CFG_DIR"
    umask 077
    { echo "WEB_PROXY=${px}"; echo "HTTPS_PROXY=${px}"; echo "HTTP_PROXY=${px}"; } > "$PROXY_ENV"
    umask 022
    export HTTPS_PROXY="$px" HTTP_PROXY="$px" https_proxy="$px" http_proxy="$px"
    log "proxy saved to ${PROXY_ENV}"
  fi
  if [[ -n "$ts" ]] && command -v tailscale >/dev/null 2>&1; then
    tailscale up --authkey="$ts" --accept-routes >/dev/null 2>&1 || true
    log "tailscale up attempted (key not logged)"
  fi
}

# Hand the URL+token to the EXISTING enroll chain and wait for engine.env. The
# window is wide because the enroll unit first pulls the engine .deb (one-time
# download this boot) before the enroll POST writes engine.env.
stage_token_and_enroll() { # url token fb_unit
  local url="$1" token="$2" fb_unit="$3"
  install -d -m0755 "$CFG_DIR"
  umask 077
  { printf '%s\n' "$token"; printf '%s\n' "$url"; } > "$TOKEN_FILE"
  chmod 0600 "$TOKEN_FILE"
  umask 022
  log "token staged; starting ${fb_unit} (token not logged)"
  systemctl start "$fb_unit" 2>/dev/null || true
  local _
  for _ in $(seq 1 150); do
    [[ -f "$CFG_ENV" ]] && break
    sleep 2
  done
}

# ---------------------------------------------------------------------------
# GUI kiosk (runs INSIDE the Xorg session via the __wizard re-exec below).
# yad preferred (branded notebook); zenity is a minimal fail-soft fallback.
# ---------------------------------------------------------------------------
DIALOG=""
pick_dialog() {
  if command -v yad >/dev/null 2>&1; then DIALOG="yad"; return 0; fi
  if command -v zenity >/dev/null 2>&1; then DIALOG="zenity"; return 0; fi
  return 1
}

# One branded multi-tab window. Loops until engine.env appears or the operator
# confirms a cancel (fail-open). Prior input is kept and prefilled on re-open.
kiosk_yad() { # fb_unit
  local fb_unit="$1"
  local def_url="" def_token="" def_proxy="" def_tskey=""
  while [[ ! -f "$CFG_ENV" ]]; do
    local tmp key status ret
    tmp="$(mktemp -d)"
    key="$RANDOM"
    status="$(net_status_line)"

    # Tab 1 - Jaringan: status snapshot + live action buttons (no captured output).
    yad --plug="$key" --tabnum=1 --form --columns=1 \
      --field="$(_t f_net_status):LBL" "" \
      --field=":RO" "$status" \
      --field="$(_t btn_net_connect):FBTN" "$SELF __net-connect" \
      --field="$(_t btn_net_editor):FBTN" "nm-connection-editor" \
      >/dev/null 2>&1 &

    # Tab 2 - Enrollment: control-plane URL + token (prefilled on re-open).
    yad --plug="$key" --tabnum=2 --form \
      --field="$(_t f_url)":TEXT "$def_url" \
      --field="$(_t f_token)":H "$def_token" \
      --field="$(_t lbl_token_hint):LBL" "" \
      > "${tmp}/2" 2>/dev/null &

    # Tab 3 - Opsional: proxy + Tailscale auth key.
    yad --plug="$key" --tabnum=3 --form \
      --field="$(_t f_proxy)":TEXT "$def_proxy" \
      --field="$(_t f_tskey)":H "$def_tskey" \
      --field="$(_t lbl_opt_hint):LBL" "" \
      > "${tmp}/3" 2>/dev/null &

    # Parent notebook: logo header + tabs + single Aktivasi button.
    local nb=(--notebook --key="$key" --tab-pos=top \
      --tab="$(_t tab_net)" --tab="$(_t tab_enroll)" --tab="$(_t tab_opt)" \
      --text="$(_t hdr_text)" \
      --text-align=center --title="$(_t title_activation)" \
      --width=640 --height=480 --center --fixed --undecorated \
      --button="$(_t btn_cancel):1" --button="$(_t btn_activate):0")
    if [[ -n "$LOGO" ]]; then nb+=(--image="$LOGO" --image-on-top --window-icon="$LOGO"); fi
    yad "${nb[@]}" 2>/dev/null
    ret=$?
    wait 2>/dev/null || true

    if [[ $ret -ne 0 ]]; then
      # Batal -> confirm. Confirmed exit fails OPEN to the fallback console.
      local cargs=(--title="vacti" --width=460 --center \
        --text="$(_t cancel_prompt)" \
        --button="$(_t btn_back_activation):1" --button="$(_t btn_exit_console):0")
      [[ -n "$LOGO" ]] && cargs+=(--image="$LOGO")
      if yad "${cargs[@]}" 2>/dev/null; then
        rm -rf "$tmp"
        return 1
      fi
      rm -rf "$tmp"
      continue
    fi

    def_url="$(cut -d'|' -f1 "${tmp}/2" 2>/dev/null || true)"
    def_token="$(cut -d'|' -f2 "${tmp}/2" 2>/dev/null || true)"
    def_proxy="$(cut -d'|' -f1 "${tmp}/3" 2>/dev/null || true)"
    def_tskey="$(cut -d'|' -f2 "${tmp}/3" 2>/dev/null || true)"
    rm -rf "$tmp"

    apply_optional "$def_proxy" "$def_tskey"

    if [[ -z "$def_url" || -z "$def_token" ]]; then
      yad_msg "$(_t err_required_full)"
      continue
    fi
    if ! reachable "$def_url"; then
      yad_msg "$(_t err_unreachable_net "$def_url")"
      continue
    fi

    # Short code typed instead of a full token? Exchange it for the full token
    # (same convenience the premium GTK kiosk offers). A full token passes through.
    local real_token="$def_token"
    if is_short_code "$def_token"; then
      local xrc
      real_token="$(resolve_exchange "$def_url" "$def_token")"; xrc=$?
      if [[ $xrc -ne 0 ]]; then
        case $xrc in
          44) yad_msg "$(_t err_notfound)" ;;
          41) yad_msg "$(_t err_gone)" ;;
          42) yad_msg "$(_t err_rate)" ;;
          *)  yad_msg "$(_t err_exchange_net)" ;;
        esac
        continue
      fi
    fi

    stage_token_and_enroll "$def_url" "$real_token" "$fb_unit"
    if [[ -f "$CFG_ENV" ]]; then
      yad_msg "$(_t ok_activated)"
      return 0
    fi
    yad_msg "$(_t err_enroll_detail "$fb_unit")"
  done
  return 0
}

yad_msg() { # text
  local args=(--title="$(_t title_activation)" --text="$1" --button="OK:0" --width=460 --center)
  [[ -n "$LOGO" ]] && args+=(--image="$LOGO")
  yad "${args[@]}" 2>/dev/null || true
}

# Minimal fail-soft fallback when only zenity is present (yad is the golden
# default; this keeps the kiosk functional if it is ever stripped).
kiosk_zenity() { # fb_unit
  local fb_unit="$1"
  zenity --info --title="$(_t title_activation)" \
    --text="$(_t z_net_info)" 2>/dev/null || true
  command -v nm-connection-editor >/dev/null 2>&1 && nm-connection-editor 2>/dev/null || true
  local px; px="$(zenity --entry --title="$(_t z_proxy_title)" --text="$(_t z_proxy_text)" 2>/dev/null || true)"
  apply_optional "$px" ""
  while [[ ! -f "$CFG_ENV" ]]; do
    local url token
    url="$(zenity --entry --title="$(_t title_activation)" --text="$(_t z_url_text)" 2>/dev/null || true)"
    token="$(zenity --entry --title="$(_t title_activation)" --text="$(_t z_token_text)" 2>/dev/null || true)"
    if [[ -z "$url" || -z "$token" ]]; then
      zenity --error --text="$(_t z_required)" 2>/dev/null || true
      continue
    fi
    if ! reachable "$url"; then
      zenity --error --text="$(_t z_unreachable "$url")" 2>/dev/null || true
      continue
    fi
    local real_token="$token"
    if is_short_code "$token"; then
      local xrc
      real_token="$(resolve_exchange "$url" "$token")"; xrc=$?
      if [[ $xrc -ne 0 ]]; then
        case $xrc in
          44) zenity --error --text="$(_t err_notfound)" 2>/dev/null || true ;;
          41) zenity --error --text="$(_t err_gone)" 2>/dev/null || true ;;
          42) zenity --error --text="$(_t err_rate)" 2>/dev/null || true ;;
          *)  zenity --error --text="$(_t err_exchange_net)" 2>/dev/null || true ;;
        esac
        continue
      fi
    fi
    stage_token_and_enroll "$url" "$real_token" "$fb_unit"
    if [[ -f "$CFG_ENV" ]]; then
      zenity --info --text="$(_t ok_activated)" 2>/dev/null || true
      return 0
    fi
    zenity --error --text="$(_t z_enroll_failed)" 2>/dev/null || true
  done
  return 0
}

# True if the premium GTK4 kiosk can actually run here (app present, python3
# present, and GTK4 + libadwaita importable). Preflighted so a missing/broken
# toolkit deterministically falls back to yad instead of crash-looping.
gtk4_kiosk_available() {
  [[ -f "$KIOSK_APP" && -n "$PYTHON_BIN" ]] || return 1
  "$PYTHON_BIN" - <<'PY' >/dev/null 2>&1
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw  # noqa
PY
}

run_wizard() {
  # A tiny WM so child windows (nm-connection-editor) are manageable under the
  # bare xinit session (best-effort; the kiosk works without it too).
  if command -v openbox >/dev/null 2>&1; then
    openbox >/dev/null 2>&1 &
    sleep 1
  fi
  local fb_unit; fb_unit="$(pick_firstboot_unit)"

  # Preferred: the premium GTK4 + libadwaita kiosk. It delegates every privileged
  # step back to this script's __subcommands, so the enroll chain stays the single
  # source of truth. Exit codes: 0=enrolled, 10=operator chose console (fail-open),
  # anything else=could not run -> fall back to the yad notebook.
  if gtk4_kiosk_available; then
    "$PYTHON_BIN" "$KIOSK_APP" "$SELF"
    local rc=$?
    case $rc in
      0)  return 0 ;;
      10) log "operator chose exit-to-console in the GTK kiosk (fail-open)"; return 1 ;;
      *)  log "GTK kiosk exited rc=${rc}; falling back to yad/zenity" ;;
    esac
  fi

  if ! pick_dialog; then
    log "no yad/zenity dialog toolkit present - cannot render the kiosk"
    return 1
  fi
  if [[ "$DIALOG" == "yad" ]]; then
    kiosk_yad "$fb_unit"
  else
    kiosk_zenity "$fb_unit"
  fi
}

# ---------------------------------------------------------------------------
# Re-exec hooks (inside the X session): the wizard client + the tab button.
# ---------------------------------------------------------------------------
case "${1:-}" in
  __wizard)
    run_wizard || exit 1
    exit 0
    ;;
  __net-connect)
    # yad FBTN: connect + branded popup.
    do_net_connect
    exit 0
    ;;
  __net-connect-quiet)
    # GTK kiosk: connect silently, print the new status line.
    do_net_connect_quiet
    exit 0
    ;;
  __net-status)
    net_status_line
    exit 0
    ;;
  __reachable)
    # $2 = url; exit 0 if the control-plane answers, else 1.
    reachable "${2:-}" && exit 0 || exit 1
    ;;
  __apply-optional)
    # proxy/tskey come via env (VACTI_PROXY / VACTI_TSKEY), never argv.
    apply_optional "${VACTI_PROXY:-}" "${VACTI_TSKEY:-}"
    exit 0
    ;;
  __exchange)
    # $2 = url; short code via env VACTI_CODE. Prints token; see resolve_exchange
    # for the exit-code contract (0 / 44 / 41 / 42 / 1).
    resolve_exchange "${2:-}" "${VACTI_CODE:-}"
    exit $?
    ;;
  __enroll)
    # $2 = url; full token via env VACTI_TOKEN. Writes enroll.token + runs the
    # existing firstboot enroll chain. Exit 0 iff engine.env appeared.
    _fb_unit="$(pick_firstboot_unit)"
    stage_token_and_enroll "${2:-}" "${VACTI_TOKEN:-}" "$_fb_unit"
    [[ -f "$CFG_ENV" ]] && exit 0 || exit 1
    ;;
  __finish)
    # Post-success: reboot into the (now ungated) desktop login; if reboot is not
    # permitted here, fall back to starting LightDM in place.
    systemctl reboot 2>/dev/null || systemctl start lightdm.service 2>/dev/null || true
    exit 0
    ;;
esac

# Marker for the boot smoke test + operator console: the activation kiosk is the
# boot destination (not a bare login). Harmless in production.
echo "VACTI_ACTIVATE_KIOSK=start" > /dev/console 2>/dev/null || true

# Already enrolled? Nothing to do - let LightDM take over immediately.
if [[ -f "$CFG_ENV" ]]; then
  log "engine.env present - handing off to the desktop login"
  systemctl start lightdm.service 2>/dev/null || true
  exit 0
fi

# A usable graphical display must exist, or we fail OPEN to the fallback getty.
# (-vga none / a headless VM / a broken GPU all land here deterministically.)
graphical_possible() {
  command -v Xorg >/dev/null 2>&1 || command -v X >/dev/null 2>&1 || return 1
  local f
  for f in /dev/dri/card*; do
    [[ -e "$f" ]] && return 0
  done
  [[ -e /dev/fb0 ]] && return 0
  return 1
}

if ! graphical_possible; then
  log "no usable graphical display (headless/no-GPU) - failing open to the console"
  echo "VACTI_ACTIVATE_NODISPLAY=1" > /dev/console 2>/dev/null || true
  exit 1
fi

if command -v xinit >/dev/null 2>&1; then
  # Bare X (no desktop): xinit runs this script's __wizard client, then exits.
  if xinit "$0" __wizard -- :0 vt1 -keeptty -nolisten tcp > "$XLOG" 2>&1; then
    :
  else
    log "Xorg/xinit exited non-zero (see ${XLOG})"
  fi
else
  log "xinit not installed - cannot start the kiosk X session"
  exit 1
fi

if [[ -f "$CFG_ENV" ]]; then
  log "enrollment complete - starting LightDM"
  systemctl start lightdm.service 2>/dev/null || true
  exit 0
fi

# Did not enroll and the X session ended: exit non-zero so systemd restarts us
# (and ultimately fails open to the console) rather than leaving a blank screen.
log "kiosk ended without enrollment - exiting non-zero (systemd will retry / fail open)"
exit 1

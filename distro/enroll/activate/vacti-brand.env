# /etc/vacti/brand.env - the single source of brand tokens for the PRE-LOGIN
# activation wizard (both the GUI yad/zenity twin and the headless whiptail twin).
# Installed by apply-branding.sh. The wizard sources this and applies the header
# lockup + tagline + navy palette, so the activation screen carries the same
# visual identity as GRUB, Plymouth, the MOTD and fastfetch (TG 7215-7219).
#
# Kept SEPARATE from the wizard logic on purpose: the wizard's control flow is
# owned by the no-OS-access UX work, while these tokens are owned by branding.
# Sourcing is a one-liner there (`. /etc/vacti/brand.env`), so the two land
# without stepping on each other. Hyphen separators only - no em-dash/en-dash.

# Product name + three-pillar tagline (matches the brand master asset).
VACTI_BRAND_NAME="Vacti OS"
VACTI_BRAND_TAGLINE="Vulnerability Assessment  -  AI Pentest  -  Threat Intelligence"
VACTI_BRAND_APPLIANCE="trixie-based pentest appliance"

# Logo artwork (shield + wordmark). The stacked "light" lockup reads on the dark
# navy wizard background; the SVG icon is the window icon. Both are shipped to
# /usr/share/vacti/branding/logo by the image build.
VACTI_BRAND_LOCKUP="/usr/share/vacti/branding/logo/png/vacti-lockup-stacked-light.png"
VACTI_BRAND_ICON="/usr/share/pixmaps/vacti.svg"

# Brand palette (hex): navy background gradient + shield blue accent + text.
VACTI_BRAND_NAVY_TOP="#0B1324"
VACTI_BRAND_NAVY_BOTTOM="#070D1A"
VACTI_BRAND_BLUE="#2563EB"
VACTI_BRAND_TEXT="#E8EDF5"
VACTI_BRAND_MUTED="#9FB0C6"

# GUI twin: a dark GTK theme so yad/zenity render on navy, not default light.
VACTI_BRAND_GTK_THEME="Adwaita:dark"

# Headless twin: whiptail/newt palette in brand navy + blue (white on navy,
# blue highlight/selection). Export as NEWT_COLORS in the wizard.
VACTI_BRAND_NEWT_COLORS="root=,black;window=white,black;border=white,black;title=brightcyan,black;textbox=white,black;listbox=white,black;actlistbox=black,brightblue;button=black,brightblue;actbutton=white,brightblue;entry=white,black;checkbox=white,black;actcheckbox=black,brightcyan"

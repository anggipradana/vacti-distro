#!/usr/bin/env bash
# /usr/local/sbin/vacti-netsetup - the HEADLESS SKU console twin of the GUI
# activation kiosk's enroll stage. For an operator on a console with NO cloud-init
# seed: set networking, (optional) proxy / host VPN, then supply the control-plane
# URL + enrollment token and drive the EXISTING first-boot enroll chain.
#
# It does NOT reimplement enroll and NEVER auto-seizes a TTY: the headless default
# stays cloud-init + systemd-networkd (zero-touch via a cidata.iso seed). This is
# an interactive, operator-invoked command, surfaced in the MOTD while the box is
# unenrolled. Run it as root (sudo vacti-netsetup).
set -euo pipefail

# ---------------------------------------------------------------------------
# i18n (EN/ID). Self-contained string table - no gettext, no new deps. Default
# is Indonesian. Language precedence: --lang en|id > VACTI_LANG env >
# /etc/vacti/lang (or ~/.config/vacti/lang) > $LANG locale. A key missing in the
# chosen language falls back to EN (warning on stderr, never fatal). Strings use
# "{}" as a value placeholder.
# ---------------------------------------------------------------------------
VACTI_LANG_FLAG=""
_vacti_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --lang) VACTI_LANG_FLAG="${2:-}"; shift 2 || shift ;;
    --lang=*) VACTI_LANG_FLAG="${1#--lang=}"; shift ;;
    *) _vacti_args+=("$1"); shift ;;
  esac
done
set -- ${_vacti_args[@]+"${_vacti_args[@]}"}

_resolve_uilang() {
  local v="" home_lang="${HOME:-/root}/.config/vacti/lang"
  if   [[ -n "${VACTI_LANG_FLAG:-}" ]]; then v="$VACTI_LANG_FLAG"
  elif [[ -n "${VACTI_LANG:-}"      ]]; then v="$VACTI_LANG"
  elif [[ -r /etc/vacti/lang        ]]; then v="$(cat /etc/vacti/lang 2>/dev/null)"
  elif [[ -r "$home_lang"           ]]; then v="$(cat "$home_lang" 2>/dev/null)"
  elif [[ "${LANG:-}" == id* || "${LC_ALL:-}" == id* ]]; then v="id"
  elif [[ -n "${LANG:-}${LC_ALL:-}" ]]; then v="en"
  fi
  v="${v,,}"; v="${v//[[:space:]]/}"
  case "$v" in en) echo en ;; id) echo id ;; *) echo id ;; esac
}
VACTI_UILANG="$(_resolve_uilang)"

declare -A VT_EN=(
  [cfg_static]="Configure a STATIC IPv4 address? (No = keep DHCP)"
  [q_iface]="Interface name"
  [q_addr]="Address/CIDR (e.g. 192.168.1.50/24)"
  [q_gw]="Gateway"
  [q_dns]="DNS servers (space-separated)"
  [cfg_proxy]="Set an HTTP(S) proxy for enrollment + the engine?"
  [q_proxy]="Proxy URL (http://host:port)"
  [cfg_vpn]="Bring up a host VPN now (wg-quick / openconnect)?"
  [cfg_wg]="Use a WireGuard config at /etc/wireguard/wg0.conf?"
  [q_oc]="openconnect server (host)"
  [q_url]="Control-plane URL (e.g. https://cp.example)"
  [q_token]="Pairing code (e.g. K7X9-R8W2) OR full enrollment token (single-use, valid 3h)"
  [err_root]="must run as root (try: sudo vacti-netsetup)"
  [already_enrolled]="engine.env already present - this box is already enrolled. Nothing to do."
  [err_url_required]="the control-plane URL is required"
  [err_token_required]="a pairing code or enrollment token is required"
  [err_no_token]="no enrollment token resolved"
  [success]="SUCCESS: engine.env written - the engine will start. Enrollment complete."
  [err_enroll_incomplete]="enrollment did not complete. The token may be expired/used (single-use, valid 3h) - re-mint and retry. See: journalctl -u vacti-firstboot.service (or vacti-firstrun.service)"
)
declare -A VT_ID=(
  [cfg_static]="Atur alamat IPv4 STATIS? (Tidak = tetap DHCP)"
  [q_iface]="Nama interface"
  [q_addr]="Alamat/CIDR (mis. 192.168.1.50/24)"
  [q_gw]="Gateway"
  [q_dns]="Server DNS (pisahkan dengan spasi)"
  [cfg_proxy]="Pakai proxy HTTP(S) untuk enrollment + engine?"
  [q_proxy]="URL proxy (http://host:port)"
  [cfg_vpn]="Nyalakan VPN host sekarang (wg-quick / openconnect)?"
  [cfg_wg]="Pakai konfigurasi WireGuard di /etc/wireguard/wg0.conf?"
  [q_oc]="Server openconnect (host)"
  [q_url]="URL control-plane (mis. https://cp.example)"
  [q_token]="Kode pairing (mis. K7X9-R8W2) ATAU token enrollment lengkap (sekali pakai, berlaku 3 jam)"
  [err_root]="harus dijalankan sebagai root (coba: sudo vacti-netsetup)"
  [already_enrolled]="engine.env sudah ada - perangkat ini sudah ter-enroll. Tidak ada yang perlu dilakukan."
  [err_url_required]="URL control-plane wajib diisi"
  [err_token_required]="kode pairing atau token enrollment wajib diisi"
  [err_no_token]="token enrollment tidak berhasil didapatkan"
  [success]="BERHASIL: engine.env tertulis - engine akan berjalan. Enrollment selesai."
  [err_enroll_incomplete]="enrollment belum selesai. Token mungkin kedaluwarsa/terpakai (sekali pakai, berlaku 3 jam) - mint ulang lalu coba lagi. Lihat: journalctl -u vacti-firstboot.service (atau vacti-firstrun.service)"
)

_lookup() { # key
  local key="$1" val=""
  if [[ "$VACTI_UILANG" == "en" ]]; then
    val="${VT_EN[$key]-}"
  else
    val="${VT_ID[$key]-}"
    if [[ -z "$val" && -n "${VT_EN[$key]-}" ]]; then
      echo "[vacti-netsetup] i18n key '$key' missing for id; using en" >&2
      val="${VT_EN[$key]}"
    fi
  fi
  if [[ -z "$val" ]]; then
    [[ -z "${VT_EN[$key]-}" ]] && echo "[vacti-netsetup] missing i18n key: $key" >&2
    val="${VT_EN[$key]-$key}"
  fi
  printf '%s' "$val"
}

# _t KEY [ARG...] -> the translated string with each "{}" replaced by an ARG.
_t() {
  local key="$1"; shift || true
  local val; val="$(_lookup "$key")"
  local a
  for a in "$@"; do val="${val/"{}"/$a}"; done
  printf '%s' "$val"
}

CFG_DIR="/etc/vacti-engine"
CFG_ENV="${CFG_DIR}/engine.env"
TOKEN_FILE="${CFG_DIR}/enroll.token"
PROXY_ENV="${CFG_DIR}/proxy.env"
NETWORKD_DIR="/etc/systemd/network"

log() { echo "[vacti-netsetup] $*"; }
die() { echo "[vacti-netsetup][ERROR] $*" >&2; exit 1; }

# Shared short-code pairing exchange (lets the enrollment prompt accept an 8-char
# pairing code in addition to a full token, like the GUI kiosk). Sourced from the
# runtime install path, with a source-tree fallback for dev checkouts. Fail-soft:
# if the helper is absent, only a FULL token works (a short code is still typed
# into the same prompt but cannot be exchanged) - enrollment itself is unaffected.
for _ph in \
  /usr/local/lib/vacti/pairing-exchange.sh \
  "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/../common/pairing-exchange.sh"; do
  if [[ -r "$_ph" ]]; then
    # shellcheck source=/dev/null
    . "$_ph"
    break
  fi
done

[[ "$(id -u)" == "0" ]] || die "$(_t err_root)"

if [[ -f "$CFG_ENV" ]]; then
  log "$(_t already_enrolled)"
  exit 0
fi

HAVE_WHIPTAIL=0
if command -v whiptail >/dev/null 2>&1; then HAVE_WHIPTAIL=1; fi

ask() { # prompt default -> echoes value (whiptail if present, else read)
  local prompt="$1" def="${2:-}"
  if [[ "$HAVE_WHIPTAIL" == "1" ]]; then
    whiptail --inputbox "$prompt" 10 70 "$def" 3>&1 1>&2 2>&3 || echo "$def"
  else
    local v
    read -r -p "${prompt} [${def}]: " v || true
    echo "${v:-$def}"
  fi
}

ask_secret() { # prompt -> echoes value (no echo to screen)
  local prompt="$1"
  if [[ "$HAVE_WHIPTAIL" == "1" ]]; then
    whiptail --passwordbox "$prompt" 10 70 3>&1 1>&2 2>&3 || true
  else
    local v
    read -r -s -p "${prompt}: " v || true
    echo >&2
    echo "$v"
  fi
}

confirm() { # prompt -> 0 yes / 1 no
  if [[ "$HAVE_WHIPTAIL" == "1" ]]; then
    whiptail --yesno "$1" 10 70 3>&1 1>&2 2>&3
  else
    local v
    read -r -p "$1 [y/N]: " v || true
    [[ "$v" =~ ^(y|Y|yes|YES)$ ]]
  fi
}

msg() { # text -> informational box (whiptail if present, else stderr)
  if [[ "$HAVE_WHIPTAIL" == "1" ]]; then
    whiptail --msgbox "$1" 12 70 3>&1 1>&2 2>&3 || true
  else
    echo "$1" >&2
  fi
}

# --- 1. networking ----------------------------------------------------------
# Default renderer is systemd-networkd. Offer a static profile; otherwise DHCP
# (the base default) is left untouched. If NetworkManager is the active renderer
# (VACTI_HEADLESS_NM=1 image), prefer nmtui.
if command -v nmtui >/dev/null 2>&1 && systemctl is-active --quiet NetworkManager 2>/dev/null; then
  log "NetworkManager active - launching nmtui for network setup"
  nmtui 2>/dev/null || true
elif confirm "$(_t cfg_static)"; then
  iface="$(ask "$(_t q_iface)" "$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')")"
  addr="$(ask "$(_t q_addr)" "")"
  gw="$(ask "$(_t q_gw)" "")"
  dns="$(ask "$(_t q_dns)" "1.1.1.1 8.8.8.8")"
  if [[ -n "$iface" && -n "$addr" ]]; then
    install -d -m0755 "$NETWORKD_DIR"
    {
      echo "[Match]"
      echo "Name=${iface}"
      echo
      echo "[Network]"
      echo "Address=${addr}"
      [[ -n "$gw" ]] && echo "Gateway=${gw}"
      # shellcheck disable=SC2086  # intentional word-split of the DNS list
      for d in $dns; do echo "DNS=${d}"; done
    } > "${NETWORKD_DIR}/10-vacti-${iface}.network"
    log "wrote ${NETWORKD_DIR}/10-vacti-${iface}.network"
    systemctl restart systemd-networkd 2>/dev/null || true
  fi
fi

# --- 2. optional proxy ------------------------------------------------------
if confirm "$(_t cfg_proxy)"; then
  px="$(ask "$(_t q_proxy)" "")"
  if [[ -n "$px" ]]; then
    install -d -m0755 "$CFG_DIR"
    umask 077
    { echo "WEB_PROXY=${px}"; echo "HTTPS_PROXY=${px}"; echo "HTTP_PROXY=${px}"; } > "$PROXY_ENV"
    umask 022
    log "proxy saved to ${PROXY_ENV}"
  fi
fi

# --- 3. optional host VPN (reach the CP behind a corporate VPN) --------------
if confirm "$(_t cfg_vpn)"; then
  if command -v wg-quick >/dev/null 2>&1 && confirm "$(_t cfg_wg)"; then
    wg-quick up wg0 2>/dev/null || log "wg-quick up wg0 failed (check /etc/wireguard/wg0.conf)"
  elif command -v openconnect >/dev/null 2>&1; then
    srv="$(ask "$(_t q_oc)" "")"
    [[ -n "$srv" ]] && { log "launching openconnect to ${srv} (interactive)"; openconnect "$srv" || log "openconnect exited"; }
  else
    log "no wg-quick/openconnect available; configure host VPN manually, then re-run"
  fi
fi

# --- 4. enroll via the EXISTING first-boot chain ----------------------------
url="$(ask "$(_t q_url)" "")"
[[ -n "$url" ]] || die "$(_t err_url_required)"

# The enrollment prompt accepts EITHER an 8-char pairing code (K7X9-R8W2) OR a
# full enrollment token. A pairing code is exchanged at the CP for the full token
# (the same convenience the GUI kiosk offers); a full token passes through
# unchanged. Loop so a mistyped/expired code can be retried without re-doing the
# network steps. The finalized full token is what lands in enroll.token below,
# so vacti-firstboot is unchanged.
token=""
while :; do
  entered="$(ask_secret "$(_t q_token)")"
  [[ -n "$entered" ]] || die "$(_t err_token_required)"
  if declare -F vacti_is_short_code >/dev/null 2>&1 && vacti_is_short_code "$entered"; then
    log "pairing code detected - exchanging for the full enrollment token (code not logged)"
    real_token="$(vacti_pairing_exchange "$url" "$entered")"; xrc=$?
    if [[ $xrc -ne 0 ]]; then
      if [[ "$VACTI_UILANG" == "en" ]]; then
        msg "$(vacti_pairing_error_en "$xrc")"
      else
        msg "$(vacti_pairing_error_id "$xrc")"
      fi
      continue
    fi
    token="$real_token"
  else
    token="$entered"
  fi
  break
done
[[ -n "$token" ]] || die "$(_t err_no_token)"

install -d -m0755 "$CFG_DIR"
umask 077
{ printf '%s\n' "$token"; printf '%s\n' "$url"; } > "$TOKEN_FILE"
chmod 0600 "$TOKEN_FILE"
umask 022
log "token staged (not logged); starting enrollment via vacti-firstboot"

if systemctl cat vacti-firstrun.service >/dev/null 2>&1; then
  systemctl start vacti-firstrun.service 2>/dev/null || true
else
  systemctl start vacti-firstboot.service 2>/dev/null || true
fi

for _ in $(seq 1 45); do
  [[ -f "$CFG_ENV" ]] && break
  sleep 2
done

if [[ -f "$CFG_ENV" ]]; then
  log "$(_t success)"
  exit 0
fi
die "$(_t err_enroll_incomplete)"

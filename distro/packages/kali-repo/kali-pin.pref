# Goes to /etc/apt/preferences.d/kali-pin. Priority 100 = "install from here
# only if the package is not available (or not at a higher-priority version)
# from the Debian base". This keeps every Debian-base package (libc, kernel,
# systemd, ...) sourced from Debian and lets the handful of Kali-only tools
# resolve. Mirrors the engine bootstrap-apt.sh ensure_kali_repo_on_ubuntu pin.
Package: *
Pin: release o=Kali
Pin-Priority: 100

# EXCEPTION: libaio1t64. The pinned Kali tools commix -> metasploit-framework
# pull oracle-instantclient-basic, whose hard dependency is
# `libaio1t64 (>= 0.3.113-8+kali1)`. Debian 13 (trixie) ships 0.3.113-8+b1,
# which is LOWER (dpkg: +b1 < +kali1) and does NOT satisfy that constraint, so
# the global prio-100 pin leaves the build with an unresolvable dependency.
# Raise ONLY libaio1t64 above the Debian base (prio 500) so apt sources this one
# tiny AIO shim from Kali; its +kali1 version is a rebuild and >= the Debian
# one, satisfying every other consumer too. The core toolchain stays on Debian.
Package: libaio1t64
Pin: release o=Kali
Pin-Priority: 990

#!/bin/sh
# live-build auto/config - committed so `lb config` is reproducible. Produces a
# hybrid BIOS+UEFI ISO (dd-able to USB) with a live session + install-to-disk.
# Headless SKU is the default; the GUI SKU is selected with VACTI_ISO_SKU=gui
# (adds the XFCE + Calamares package list). The package set, branding, and
# enroll overlay are materialized from the shared distro/ tree by build-iso.sh
# BEFORE this runs.
set -e

VACTI_RELEASE="${VACTI_RELEASE:-0.1.0}"
VACTI_ISO_SKU="${VACTI_ISO_SKU:-headless}"   # headless | gui

# Target architecture (from the CI leg via DEBIAN_ARCH; default amd64). amd64
# keeps the historical hybrid BIOS(isolinux)+UEFI(grub) ISO and its exact lb
# config call unchanged. arm64 is UEFI/GRUB-EFI ONLY: there is no BIOS/isolinux on
# arm64 (hardware reality, not a defect), so for arm64 we pin the arm64 kernel
# flavour, restrict the bootloader to grub-efi, add the arm serial console, and
# tag the volume id so the two arches never collide. All arm64-only options live
# in EXTRA_OPTS so amd64's invocation is byte-for-byte what it always was.
VACTI_DEB_ARCH="${DEBIAN_ARCH:-amd64}"
EXTRA_OPTS=""
VACTI_VOL_ARCH=""
BOOTAPPEND="boot=live components quiet splash console=tty0 console=ttyS0,115200"
case "$VACTI_DEB_ARCH" in
  arm64|aarch64)
    VACTI_DEB_ARCH="arm64"
    EXTRA_OPTS="--linux-flavours arm64 --bootloaders grub-efi"
    VACTI_VOL_ARCH="-arm64"
    BOOTAPPEND="${BOOTAPPEND} console=ttyAMA0,115200"
    ;;
  *)
    VACTI_DEB_ARCH="amd64"
    ;;
esac

# GUI SKU ships debian-installer live (so Calamares can run from the session);
# headless keeps d-i for the preseeded unattended install.
DI_FLAVOUR="live"
[ "$VACTI_ISO_SKU" = "headless" ] && DI_FLAVOUR="true"

# bootappend-live carries a serial console (console=ttyS0) IN ADDITION to the
# video console (console=tty0, kept primary for the GUI/live session). This lets
# kernel + systemd ("Reached target ...") output and an auto-spawned serial getty
# login prompt reach a serial line - needed so the qemu-TCG smoke test (which
# runs -nographic -serial file:) can observe the boot, and genuinely useful for a
# headless appliance over a serial/virtual console. Harmless on hardware with no
# serial port (output is discarded; the screen stays primary).
# --apt-options hardens EVERY apt invocation live-build drives (the archive
# apt-update AND the heavy install-packages fetch, for both the Debian and the
# pinned Kali source) against a transient mirror failure. http.kali.org and
# deb.debian.org are DNS round-robins across third-party mirrors; one mirror
# returning HTTP 500/timeout on a single .deb has aborted the whole build. With
# Acquire::Retries, apt re-requests the failed file (re-resolving the round-robin,
# so a retry usually lands on a healthy mirror) before giving up. --yes is kept
# because it is live-build's APT_OPTIONS default and the install step needs it.
# shellcheck disable=SC2086  # EXTRA_OPTS is intentional word-split option list (empty on amd64)
lb config noauto \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures "$VACTI_DEB_ARCH" \
  $EXTRA_OPTS \
  --binary-images iso-hybrid \
  --bootappend-live "$BOOTAPPEND" \
  --debian-installer "${DI_FLAVOUR}" \
  --iso-application "vacti" \
  --iso-publisher "vacti; https://vacti.example; info@vacti.example" \
  --iso-volume "vacti-${VACTI_RELEASE}${VACTI_VOL_ARCH}" \
  --apt-indices false \
  --apt-recommends false \
  --apt-options "--yes -o Acquire::Retries=5 -o Acquire::Retries::Delay::Maximum=15" \
  --cache true \
  --memtest none \
  "${@}"

#!/bin/sh
# 0310-ghidra.hook.chroot - bake Ghidra (NSA SRE) into the live-build ISO rootfs.
# The ISO counterpart of golden-image/install-ghidra.sh; self-contained because a
# live-build hook cannot source a file from outside the chroot. Keep this body IN
# SYNC with golden-image/install-ghidra.sh, the pin in vacti-appliance.env
# (VACTI_GHIDRA_*), and the engine's packaging/bootstrap-apt.sh GHIDRA_VERSION.
#
# MANDATORY on every image + every SKU: runs unconditionally, as REA's native
# binary-decompile engine. Ghidra 11.1.2 needs JDK 17+; trixie default-jre-headless
# (in the baked package list) is JDK 21, which satisfies it. Sets GHIDRA_INSTALL_DIR
# + JAVA_HOME in the image. SIZE: ~1GB unpacked under /opt/ghidra (deliberate).
#
# Runs at chroot_hooks (after the package lists install). Best-effort, no `set -e`.
set -u

GHIDRA_VERSION="11.1.2"                                   # PINNED; keep == VACTI_GHIDRA_VERSION / engine
GHIDRA_RELEASE_TAG="Ghidra_11.1.2_build"
GHIDRA_ASSET="ghidra_11.1.2_PUBLIC_20240709.zip"
GHIDRA_DIR="/opt/ghidra"

log()  { echo "[ghidra] $*"; }
warn() { echo "[ghidra][warn] $*" >&2; }

export DEBIAN_FRONTEND=noninteractive

# --- 1. JRE (Ghidra 11.1.2 needs JDK 17+; trixie default-jre-headless = JDK 21) --
if command -v java >/dev/null 2>&1; then
  log "JRE present: $(java -version 2>&1 | head -1)"
else
  log "no JRE on PATH; installing openjdk-21-jre-headless (Ghidra ${GHIDRA_VERSION} needs JDK 17+)"
  apt-get install -y --no-install-recommends openjdk-21-jre-headless \
    || apt-get install -y --no-install-recommends default-jre-headless \
    || warn "JRE install failed; Ghidra will not run until a JDK 17+ is present"
fi

# --- 2. download + unpack the pinned Ghidra release (mirror engine step_ghidra) --
if command -v analyzeHeadless >/dev/null 2>&1; then
  log "analyzeHeadless already present ($(command -v analyzeHeadless)); skipping download"
elif command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
  url="https://github.com/NationalSecurityAgency/ghidra/releases/download/${GHIDRA_RELEASE_TAG}/${GHIDRA_ASSET}"
  tmp="$(mktemp -d)"
  log "downloading Ghidra ${GHIDRA_VERSION} -> ${GHIDRA_DIR}"
  if curl -fsSL -m 600 -o "${tmp}/ghidra.zip" "$url"; then
    rm -rf "$GHIDRA_DIR"; mkdir -p "$GHIDRA_DIR"
    if unzip -q -o "${tmp}/ghidra.zip" -d "$GHIDRA_DIR"; then
      _root="$(find "$GHIDRA_DIR" -maxdepth 1 -type d -name 'ghidra_*' | head -1)"
      if [ -n "$_root" ]; then
        chmod +x "${_root}/ghidraRun" "${_root}/support/analyzeHeadless" 2>/dev/null || true
        ln -sf "${_root}/ghidraRun" /usr/local/bin/ghidra
        ln -sf "${_root}/support/analyzeHeadless" /usr/local/bin/analyzeHeadless
        log "installed ${_root} + symlinked ghidra/analyzeHeadless to /usr/local/bin"
      else
        warn "unpacked but no ghidra_* dir found; skipping symlink"
      fi
    else
      warn "unzip failed; Ghidra unavailable"
    fi
  else
    warn "download failed (${url}); Ghidra unavailable until self-heal/minting installs it"
  fi
  rm -rf "$tmp" 2>/dev/null || true
else
  warn "curl/unzip missing; skipping Ghidra"
fi

# --- 3. bake GHIDRA_INSTALL_DIR + JAVA_HOME into the image ---------------------
GH_ROOT="$(find "$GHIDRA_DIR" -maxdepth 1 -type d -name 'ghidra_*' 2>/dev/null | head -1)"
JAVA_HOME_DIR=""
JAVA_BIN="$(command -v java 2>/dev/null || true)"
if [ -n "$JAVA_BIN" ]; then
  JAVA_REAL="$(readlink -f "$JAVA_BIN" 2>/dev/null || echo "$JAVA_BIN")"
  JAVA_HOME_DIR="$(dirname "$(dirname "$JAVA_REAL")")"
fi

{
  echo "# vacti: REA native-decompile engine (Ghidra). Generated by 0310-ghidra.hook.chroot."
  [ -n "${GH_ROOT}" ]       && echo "export GHIDRA_INSTALL_DIR=\"${GH_ROOT}\""
  [ -n "${JAVA_HOME_DIR}" ] && echo "export JAVA_HOME=\"${JAVA_HOME_DIR}\""
} > /etc/profile.d/vacti-ghidra.sh
chmod 0644 /etc/profile.d/vacti-ghidra.sh

sed -i '/^GHIDRA_INSTALL_DIR=/d; /^JAVA_HOME=/d' /etc/environment 2>/dev/null || true
[ -n "${GH_ROOT}" ]       && echo "GHIDRA_INSTALL_DIR=${GH_ROOT}" >> /etc/environment
[ -n "${JAVA_HOME_DIR}" ] && echo "JAVA_HOME=${JAVA_HOME_DIR}" >> /etc/environment

log "Ghidra bake complete (GHIDRA_INSTALL_DIR=${GH_ROOT:-unset}, JAVA_HOME=${JAVA_HOME_DIR:-unset})"

Package: *
Pin: release o=Kali
Pin-Priority: 100

# EXCEPTION: libaio1t64. The pinned Kali tools commix -> metasploit-framework
# pull oracle-instantclient-basic, whose hard dependency is
# `libaio1t64 (>= 0.3.113-8+kali1)`. Debian 13 (trixie) ships 0.3.113-8+b1,
# which is LOWER (dpkg: +b1 < +kali1) and does NOT satisfy that constraint, so
# the global prio-100 pin leaves the ISO build with an unresolvable dep
# ("oracle-instantclient-basic : Depends: libaio1t64 (>= 0.3.113-8+kali1) but
# 0.3.113-8+b1 is to be installed"). Raise ONLY libaio1t64 above the Debian
# base (prio 500) so apt sources this one tiny AIO shim from Kali; its +kali1
# version is a rebuild and >= the Debian one, satisfying every other consumer
# too. The core toolchain (libc/kernel/systemd) stays on Debian via the prio-100
# default above.
Package: libaio1t64
Pin: release o=Kali
Pin-Priority: 990

# vacti-appliance.env - the ONE config that drives every build form.
#
# Both build drivers (golden-image/build-golden.sh via virt-customize, and
# live-build-config via live-build) source the SAME values from here, so the
# cloud qcow2, the installable ISO, and the two OVAs are the same engine:
# same base pin, same engine .deb, same arsenal, same branding, same enroll.
#
# NOTHING in this file is a secret. The build-time private-repo credential is
# supplied out-of-band via the environment (VACTI_APT_PRODUCER_TOKEN) and is
# NEVER written to a shipped image. See golden-image/build-golden.sh.

# --- Base OS (Debian 13 "trixie", headless genericcloud) ------------------
DEBIAN_SUITE="trixie"
DEBIAN_VERSION="13"
DEBIAN_ARCH="amd64"                   # arm64 available for the same variant
# Official Debian cloud image + its checksum manifest. Pin the exact point
# release per vacti-distro release; the build verifies against SHA512SUMS.
DEBIAN_CLOUD_BASEURL="https://cloud.debian.org/images/cloud/trixie/latest"
DEBIAN_CLOUD_IMAGE="debian-13-genericcloud-${DEBIAN_ARCH}.qcow2"
DEBIAN_CLOUD_SHA512SUMS="SHA512SUMS"

# --- vacti engine + control plane -----------------------------------------
# Build-time apt source only (the host the build pulls vacti-engine from). This
# is NOT baked as an enroll endpoint - the running image learns its CP from the
# per-boot enroll token's payload. Default to a placeholder the operator sets.
VACTI_APT_URL="${VACTI_APT_URL:-https://repo.vacti.example}"
# The .deb to install from the private apt repo.
VACTI_ENGINE_PKG="vacti-engine"
# Pinned Chromium build (1228) matched to the engine's playwright-core.
VACTI_CHROMIUM_PKG="vacti-engine-chromium"
# REA (rea-agents) - MANDATORY reverse-engineering MCP, baked on every image by
# golden-image/install-rea.sh and the ISO hook 0300-rea.hook.chroot. PINNED per
# the 2026-10-13 safety vetting (no install scripts; --ignore-scripts anyway).
# Node floor ^22.19 || ^24.11 || >=26 (NodeSource setup_22.x satisfies it). Only
# the runtime (Node + the global package) is baked; the MCP registration + the
# reverse-engineer-anything skill are the engine/minting side's job (no .claude
# on disk). The ISO hook hard-codes the same value - keep them in sync.
VACTI_REA_VERSION="${VACTI_REA_VERSION:-6.4.0}"

# --- Capabilities / arsenal flavour ---------------------------------------
# Baked default is lean web+infra (smallest image). The runtime arsenal-check
# self-heals any gap post-boot via the NOPASSWD apt grant.
ENGINE_CAPABILITIES="${ENGINE_CAPABILITIES:-web,infra}"
# VACTI_FULL_ARSENAL=1 bakes the full superset (packages/full.list) instead of
# the lean set (packages/web-lean.list).
VACTI_FULL_ARSENAL="${VACTI_FULL_ARSENAL:-0}"
# VACTI_CTF_ARSENAL=1 additionally bakes the CTF tool set (forensics, steg,
# crypto, pwn, reverse, password-cracking) via golden-image/install-ctf-arsenal.sh
# plus packages/ctf.list. Default OFF: the image stays lean, and kind=ctf
# engagements self-heal the heavy CTF tools post-boot otherwise. Deliberately
# excludes sagemath/ghidra/stegsolve (multi-GB / GUI); set up only when the
# operator specifically wants a CTF-ready appliance.
VACTI_CTF_ARSENAL="${VACTI_CTF_ARSENAL:-0}"

# --- Package source policy (Option A vs Option B) -------------------------
# Option A (default): add the Kali apt repo as an ordinary, PINNED (prio 100)
# package SOURCE for the ~6 tools absent from Debian main. No Kali branding
# reaches the image. Set VACTI_NO_KALI_REPO=1 for the fully Kali-free Option B
# (nuclei/httpx/naabu via go-install, seclists via git, feroxbuster via GitHub
# release, commix via git - the engine's existing runtime fallbacks).
VACTI_NO_KALI_REPO="${VACTI_NO_KALI_REPO:-0}"

# --- Output / product identity --------------------------------------------
VACTI_PRODUCT_NAME="vacti"
VACTI_PRODUCT_PRETTY="vacti pentest appliance"
# Release version stamped into artifact filenames and /etc/os-release.
VACTI_RELEASE="${VACTI_RELEASE:-0.1.0}"
OUT_DIR="${OUT_DIR:-out}"

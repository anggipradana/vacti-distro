// Vacti OS Plymouth boot splash.
//
// Lightweight by design (the "works everywhere" rule): a static brand-navy
// background image, the centered radar-shield logomark, and a single thin
// accent progress bar. No blur, no particle effects, no per-frame redraw storm,
// so it renders cleanly on any GPU or in a plain framebuffer.
//
// Assets (same directory): background.png, logo.png, progress_box.png,
// progress_bar.png. All are shipped by apply-branding.sh.

// --- brand-navy fallback fill (used for letterboxing around the image) -------
Window.SetBackgroundTopColor(0.043, 0.075, 0.141);     // #0B1324
Window.SetBackgroundBottomColor(0.027, 0.051, 0.102);  // #070D1A

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

// --- background image, scaled to cover the screen ----------------------------
bg.image = Image("background.png");
bg.image = bg.image.Scale(screen_w, screen_h);
bg.sprite = Sprite(bg.image);
bg.sprite.SetPosition(0, 0, 0);

// --- centered logomark + wordmark --------------------------------------------
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_w / 2 - logo.image.GetWidth() / 2;
logo.y = screen_h / 2 - logo.image.GetHeight() / 2 - screen_h / 14;
logo.sprite.SetPosition(logo.x, logo.y, 1);

// --- progress bar (track + accent fill) --------------------------------------
box.image = Image("progress_box.png");
bar.image = Image("progress_bar.png");
box.x = screen_w / 2 - box.image.GetWidth() / 2;
box.y = logo.y + logo.image.GetHeight() + screen_h / 10;
box.sprite = Sprite(box.image);
box.sprite.SetPosition(box.x, box.y, 1);
bar.sprite = Sprite();
bar.sprite.SetPosition(box.x, box.y, 2);

fun progress_callback(duration, progress) {
    w = box.image.GetWidth() * progress;
    if (w < 1) w = 1;
    bar.sprite.SetImage(bar.image.Scale(w, bar.image.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

// --- status / password messages ----------------------------------------------
message.sprite = Sprite();
message.y = box.y + screen_h / 18;
fun message_callback(text) {
    message.image = Image.Text(text, 0.86, 0.90, 0.97);   // light foreground
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(screen_w / 2 - message.image.GetWidth() / 2, message.y, 2);
}
Plymouth.SetMessageFunction(message_callback);

// --- LUKS / sudo password prompt (keeps the brand frame during unlock) --------
fun display_password_callback(prompt, bullets) {
    dots = "";
    i = 0;
    while (i < bullets) { dots = dots + "*"; i++; }
    message_callback(prompt + "  " + dots);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    message_callback("");
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

<?xml version="1.0" encoding="UTF-8"?>
<!-- VMware-flavoured OVF 1.0 descriptor (VirtualSystemType=vmx-13, LSI Logic
     SCSI). Placeholders @VMDK@ @DISK_CAPACITY@ @DISK_POPULATED@ @PRODUCT@
     @VERSION@ are filled by convert-vmware-ova.sh. Imports to Workstation /
     Player / Fusion / ESXi. -->
<Envelope xmlns="http://schemas.dmtf.org/ovf/envelope/1"
          xmlns:ovf="http://schemas.dmtf.org/ovf/envelope/1"
          xmlns:rasd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_ResourceAllocationSettingData"
          xmlns:vssd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_VirtualSystemSettingData"
          xmlns:vmw="http://www.vmware.com/schema/ovf">
  <References>
    <File ovf:href="@VMDK@" ovf:id="file1" ovf:size="@DISK_POPULATED@"/>
  </References>
  <DiskSection>
    <Info>Virtual disk information</Info>
    <Disk ovf:capacity="@DISK_CAPACITY@" ovf:capacityAllocationUnits="byte"
          ovf:diskId="vmdisk1" ovf:fileRef="file1"
          ovf:format="http://www.vmware.com/interfaces/specifications/vmdk.html#streamOptimized"
          ovf:populatedSize="@DISK_POPULATED@"/>
  </DiskSection>
  <NetworkSection>
    <Info>The list of logical networks</Info>
    <Network ovf:name="VM Network"><Description>NAT or bridged network</Description></Network>
  </NetworkSection>
  <VirtualSystem ovf:id="@PRODUCT@">
    <Info>@PRODUCT@ @VERSION@</Info>
    <Name>@PRODUCT@ @VERSION@</Name>
    <OperatingSystemSection ovf:id="96" vmw:osType="@VMW_OSTYPE@">
      <Info>The kind of installed guest operating system</Info>
      <Description>Debian GNU/Linux (64-bit) derivative</Description>
    </OperatingSystemSection>
    <!-- vApp properties (TG 7212): the import dialog presents these fields so the
         operator can inject the single-use enrollment token + control-plane URL
         (and an OPTIONAL bootstrap Tailscale authkey) at deploy time, for a silent
         first-boot enroll with no pre-login wizard. NONE is baked into the OVA; the
         values travel in the per-deployment OVF environment, delivered to the guest
         via the com.vmware.guestInfo transport and read by vacti-firstboot. The
         Tailscale authkey is BOOTSTRAP-ONLY: after first join the engine rotates it
         from the control plane (see vacti-firstboot / the engine refresh timer). -->
    <ProductSection ovf:required="false">
      <Info>vacti engine enrollment</Info>
      <Product>@PRODUCT@</Product>
      <Version>@VERSION@</Version>
      <Category>vacti enrollment</Category>
      <Property ovf:key="vacti.url" ovf:type="string" ovf:userConfigurable="true">
        <Label>Control-plane URL</Label>
        <Description>e.g. https://cp.example - where this engine enrolls</Description>
      </Property>
      <Property ovf:key="vacti.enroll_token" ovf:type="string" ovf:password="true" ovf:userConfigurable="true">
        <Label>Enrollment token (license)</Label>
        <Description>Single-use token (valid 3h), minted once in the dashboard</Description>
      </Property>
      <Property ovf:key="vacti.tailscale_authkey" ovf:type="string" ovf:password="true" ovf:userConfigurable="true">
        <Label>Tailscale authkey (optional bootstrap)</Label>
        <Description>Optional. Used only for the FIRST tailnet join; the engine rotates it from the control plane afterwards</Description>
      </Property>
    </ProductSection>
    <!-- com.vmware.guestInfo transport delivers the OVF environment (with the
         properties above) to the guest, where vmware-rpctool / cloud-init reads it. -->
    <VirtualHardwareSection ovf:transport="com.vmware.guestInfo">
      <Info>Virtual hardware requirements</Info>
      <System>
        <vssd:ElementName>Virtual Hardware Family</vssd:ElementName>
        <vssd:InstanceID>0</vssd:InstanceID>
        <vssd:VirtualSystemIdentifier>@PRODUCT@</vssd:VirtualSystemIdentifier>
        <vssd:VirtualSystemType>vmx-13</vssd:VirtualSystemType>
      </System>
      <Item>
        <rasd:AllocationUnits>hertz * 10^6</rasd:AllocationUnits>
        <rasd:Description>Number of Virtual CPUs</rasd:Description>
        <rasd:ElementName>2 virtual CPU(s)</rasd:ElementName>
        <rasd:InstanceID>1</rasd:InstanceID>
        <rasd:ResourceType>3</rasd:ResourceType>
        <rasd:VirtualQuantity>2</rasd:VirtualQuantity>
      </Item>
      <Item>
        <rasd:AllocationUnits>byte * 2^20</rasd:AllocationUnits>
        <rasd:Description>Memory Size</rasd:Description>
        <rasd:ElementName>8192MB of memory</rasd:ElementName>
        <rasd:InstanceID>2</rasd:InstanceID>
        <rasd:ResourceType>4</rasd:ResourceType>
        <rasd:VirtualQuantity>8192</rasd:VirtualQuantity>
      </Item>
      <Item>
        <rasd:Address>0</rasd:Address>
        <rasd:ElementName>SCSI Controller 0</rasd:ElementName>
        <rasd:InstanceID>3</rasd:InstanceID>
        <rasd:ResourceSubType>lsilogic</rasd:ResourceSubType>
        <rasd:ResourceType>6</rasd:ResourceType>
      </Item>
      <Item>
        <rasd:AddressOnParent>0</rasd:AddressOnParent>
        <rasd:ElementName>Hard Disk 1</rasd:ElementName>
        <rasd:HostResource>ovf:/disk/vmdisk1</rasd:HostResource>
        <rasd:InstanceID>4</rasd:InstanceID>
        <rasd:Parent>3</rasd:Parent>
        <rasd:ResourceType>17</rasd:ResourceType>
      </Item>
      <Item>
        <rasd:AddressOnParent>7</rasd:AddressOnParent>
        <rasd:AutomaticAllocation>true</rasd:AutomaticAllocation>
        <rasd:Connection>VM Network</rasd:Connection>
        <rasd:ElementName>Ethernet 1</rasd:ElementName>
        <rasd:InstanceID>5</rasd:InstanceID>
        <rasd:ResourceSubType>vmxnet3</rasd:ResourceSubType>
        <rasd:ResourceType>10</rasd:ResourceType>
      </Item>
    </VirtualHardwareSection>
  </VirtualSystem>
</Envelope>
